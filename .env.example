# ============================================================
# .env.example —— 配置模板：复制为 .env 后填入真实密钥
#   copy .env.example .env   (Windows)
#   真实 .env 已被 .gitignore 排除，切勿提交
# ============================================================

# LLM（大模型网关）
LLM_MODEL="ZHIPU/GLM-5.3-Flash"
LLM_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
LLM_API_KEY=

# Embedding 模型
EMBEDDING_MODEL_NAME=text-embedding-v4
EMBEDDING_DIMENSION=768

# RAG 知识库（ChromaVectorStore 默认读取，main.py / test.py 无需再传参）
RAG_COLLECTION_NAME=device_knowledge
RAG_PERSIST_DIR=chroma_kb/chroma_kb

# MinerU 在线解析（本地文件走 file-urls/batch 上传链路；base 需含 /api/v4）
MINERU_BASE_URL=https://mineru.net/api/v4
MINERU_TOKEN=
MINERU_MODEL_VERSION=vlm
MINERU_ENABLE_OCR=true
MINERU_ENABLE_FORMULA=true
MINERU_ENABLE_TABLE=true
MINERU_LANGUAGE=ch
MINERU_POLL_TIMEOUT=300
MINERU_POLL_INTERVAL=3

# 文档入库管线切块/向量化参数
INGEST_MAX_CHARS=600
INGEST_OVERLAP=120
INGEST_EMBED_BATCH=10
INGEST_EXTS=.pdf,.png,.jpg,.jpeg,.jp2,.webp,.gif,.bmp,.docx,.pptx,.xlsx

# 联网搜索
TAVILY_API_KEY=
